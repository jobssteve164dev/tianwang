{
  "name": "tianwang-agent",
  "version": "1.0.0",
  "description": "TianWang AI Security Monitoring System - Desktop Agent",
  "main": "src/main.js",
  "homepage": "./",
  "private": true,
  "author": "TianWang Team",
  "license": "MIT",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "electron-pack": "electron-builder",
    "preelectron-pack": "npm run build",
    "build": "node scripts/build.js",
    "start": "npm run electron-dev",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "ws": "^8.14.0",
    "node-cron": "^3.0.3",
    "systeminformation": "^5.21.0",
    "winston": "^3.11.0",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  },
  "build": {
    "appId": "com.tianwang.agent",
    "productName": "TianWang Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main.js",
      "!src/preload.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
} 