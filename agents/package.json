{
  "name": "tianwang-agent",
  "version": "1.0.0",
  "description": "TianWang AI Security Monitoring System - Desktop Agent",
  "main": "src/main.js",
  "homepage": "./",
  "private": true,
  "author": "TianWang Team",
  "license": "MIT",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=1 electron .",
    "electron-pack": "electron-builder",
    "preelectron-pack": "npm run build",
    "build": "node scripts/build.js",
    "start": "npm run electron-dev",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate-icons": "node scripts/generate-macos-icons.js"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "electron-store": "^8.1.0",
    "node-cron": "^3.0.3",
    "systeminformation": "^5.30.8",
    "winston": "^3.11.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "concurrently": "^8.2.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.tianwang.agent",
    "productName": "TianWang Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "provisioningProfile": "build/embedded.provisionprofile"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main.js",
      "!src/preload.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
