# 天网安全监控系统 - 开发环境配置

# 应用基础配置
NODE_ENV=development
APP_NAME=tianwang
APP_VERSION=1.0.0-alpha.1
APP_PORT=8000
APP_HOST=0.0.0.0

# 数据库配置 - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tianwang
DB_USER=tianwang
DB_PASSWORD=tianwang123
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# 时序数据库配置 - InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=tianwang-super-secret-auth-token
INFLUXDB_ORG=tianwang
INFLUXDB_BUCKET=security_logs

# 缓存数据库配置 - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tianwang123
REDIS_DB=0
REDIS_TTL=3600

# 消息队列配置 - Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tianwang-server
KAFKA_GROUP_ID=tianwang-consumer-group
KAFKA_TOPICS_LOGS=security-logs
KAFKA_TOPICS_ALERTS=security-alerts
KAFKA_TOPICS_ACTIONS=protection-actions

# JWT认证配置
JWT_SECRET=tianwang-jwt-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 加密配置
CRYPTO_SECRET_KEY=tianwang-crypto-secret-32-chars-key
CRYPTO_ALGORITHM=aes-256-gcm

# API限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESS=true

# 日志配置
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# AI引擎配置
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_TIMEOUT=30000
AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.8

# 外部API配置
OPENAI_API_KEY=your-openai-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# 威胁情报配置
MISP_URL=https://your-misp-instance.com
MISP_API_KEY=your-misp-api-key
OTX_API_KEY=your-otx-api-key

# 邮件通知配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=tianwang-alerts@your-domain.com

# 短信通知配置 (阿里云)
ALIYUN_SMS_ACCESS_KEY=your-aliyun-access-key
ALIYUN_SMS_SECRET_KEY=your-aliyun-secret-key
ALIYUN_SMS_SIGN_NAME=天网安全
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# Webhook通知配置
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_TIMES=3
WEBHOOK_RETRY_DELAY=1000

# 文件存储配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=100mb
ALLOWED_FILE_TYPES=.log,.txt,.json,.xml,.csv

# CORS配置
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# SSL/TLS配置
SSL_ENABLED=false
SSL_KEY_PATH=./ssl/private.key
SSL_CERT_PATH=./ssl/certificate.crt

# 监控配置
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
METRICS_PORT=9090

# 开发工具配置
DEBUG_ENABLED=true
SWAGGER_ENABLED=true
PROFILER_ENABLED=false 