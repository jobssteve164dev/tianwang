# AI引擎环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改配置

# 应用基础配置
AI_APP_NAME=tianwang-ai-engine
AI_APP_VERSION=1.0.0-alpha.1
AI_HOST=0.0.0.0
AI_PORT=8888
AI_DEBUG=true

# 数据库配置
AI_INFLUXDB_URL=http://localhost:8086
AI_INFLUXDB_TOKEN=tianwang-super-secret-auth-token
AI_INFLUXDB_ORG=tianwang
AI_INFLUXDB_BUCKET=security_logs

AI_REDIS_HOST=localhost
AI_REDIS_PORT=6379
AI_REDIS_PASSWORD=
AI_REDIS_DB=0

# Kafka配置
AI_KAFKA_BROKERS=localhost:9092
AI_KAFKA_GROUP_ID=ai-engine-consumer

# AI模型配置
AI_AI_MODEL_PATH=./models
AI_CONFIDENCE_THRESHOLD=0.8
AI_BATCH_SIZE=32
AI_MAX_SEQUENCE_LENGTH=512

# 外部AI API配置
AI_OPENAI_API_KEY=your-openai-api-key-here
AI_CLAUDE_API_KEY=your-claude-api-key-here
AI_GEMINI_API_KEY=your-gemini-api-key-here

# 威胁情报配置
AI_MISP_URL=https://your-misp-instance.com
AI_MISP_API_KEY=your-misp-api-key-here
AI_OTX_API_KEY=your-otx-api-key-here

# 日志配置
AI_LOG_LEVEL=DEBUG
AI_LOG_FORMAT={time} | {level} | {name} | {message}
AI_LOG_FILE=./logs/ai-engine.log
AI_LOG_ROTATION=1 day
AI_LOG_RETENTION=30 days

# 性能配置
AI_MAX_WORKERS=4
AI_QUEUE_SIZE=1000
AI_PROCESSING_TIMEOUT=300
